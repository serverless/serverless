{
  "name": "frameworks-core",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0 || ^26.0.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "^12.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prettier": "prettier -c .",
    "prettier:fix": "prettier -w .",
    "test": "npm run test:unit -w @serverlessinc/sf-core -w @serverless/framework -w @serverless/mcp",
    "setup-dev-mode": "bash setup-dev-for-dev-mode.sh",
    "prepare": "husky"
  },
  "workspaces": [
    "packages/*",
    "!packages/framework-dist",
    "!packages/sf-core-installer",
    "release-scripts"
  ],
  "author": "Serverless Inc.",
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-plugin-jest": "^29.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "prettier -w"
    ]
  },
  "overrides": {
    "jest@30": {
      "glob@<11": "^13.0.6"
    },
    "aws-sdk": {
      "uuid": "^11.1.1"
    },
    "babel-plugin-istanbul": {
      "test-exclude@<8": "^8.0.0"
    }
  },
  "allowScripts": {
    "aws-crt": true,
    "aws-sdk": true,
    "cpu-features": true,
    "es5-ext": true,
    "esbuild": true,
    "fsevents": true,
    "protobufjs": true,
    "ssh2": true,
    "unrs-resolver": true
  }
}
