{
  "name": "@serverlessinc/sf-core",
  "version": "4.45.0",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prettier": "prettier -c . --ignore-path ../../.prettierignore",
    "prettier:fix": "prettier -w . --ignore-path ../../.prettierignore",
    "test:unit": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest --workerIdleMemoryLimit=1000MB \"tests/unit/.*\"",
    "test": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest \"tests/integration/.*\" --testSequencer=./tests/integration/sequencer.cjs --testPathIgnorePatterns=/node_modules/ --testPathIgnorePatterns=tests/integration/domains --testPathIgnorePatterns=tests/integration/mcp/ --testPathIgnorePatterns=tests/integration/dev-mode/",
    "test:sam": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/sam/**",
    "test:simple:nodejs": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/simple-nodejs/**",
    "test:sandboxes": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/sandboxes/**",
    "test:web-apps": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/web-apps/",
    "test:durable": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/durable/",
    "test:simple:python": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/simple-python/**",
    "test:simple:dashboard": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/simple-dashboard/**",
    "test:simple:compose": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/simple-compose/**",
    "test:compose:subset": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/compose-service-subset/**",
    "test:compose:dev": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/compose-dev/**",
    "test:compose:service-provider": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/compose-service-provider/**",
    "test:simple:resolvers": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/resolvers/**",
    "test:resolvers": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/resolvers/",
    "test:esbuild": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/esbuild/**",
    "test:domains": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/domains/http-api/** tests/integration/domains/web-apps/** --runInBand",
    "test:state": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/state/**",
    "test:deployment-bucket": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/deployment-bucket/**",
    "test:eventbridge-custom-bus": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/eventbridge-custom-bus/",
    "test:license-key": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/license-key/**",
    "test:mcp": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/mcp/ --testPathIgnorePatterns=/node_modules/ --maxWorkers=2",
    "test:dev-mode": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/dev-mode/ --runInBand",
    "test:dev-mode:agent-loop": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/integration/dev-mode/agent-loop.test.js --runInBand",
    "test:binary": "cross-env BINARY_INTEGRATION_TESTS=true NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\"  NODE_NO_WARNINGS=1 jest \"tests/integration/.*\" --testPathIgnorePatterns=/node_modules/ --testPathIgnorePatterns=tests/integration/mcp/ --testPathIgnorePatterns=tests/integration/dev-mode/",
    "test:e2e:proxy": "node --test tests/e2e/proxy.test.js",
    "test:python": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" NODE_NO_WARNINGS=1 jest tests/python/test.js",
    "build": "node esbuild.js",
    "test:build": "cd ../.. && npm i && npm run build:mcp:entry -w @serverless/framework && npm run build:devmode:layer -w @serverless/framework && npm run build:devmode:web-bridge -w @serverless/framework && cd packages/sf-core && npm run build && cd scripts && rm -rf ../../framework-dist/lib && node ./prepareDistributionTarballs.js && cd ../../framework-dist && bash ../sf-core/scripts/pack-framework-dist.sh && rm -rf package && tar -xvzf serverlessinc-framework-alpha-$npm_package_version.tgz && bash ../sf-core/scripts/verify-release-package.sh package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serverless/serverless.git"
  },
  "author": "Serverless Inc.",
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.1154.0",
    "@aws-sdk/client-iam": "3.1154.0",
    "@aws-sdk/client-iot": "3.1154.0",
    "@aws-sdk/client-lambda": "3.1154.0",
    "@aws-sdk/client-sqs": "3.1154.0",
    "@jest/test-sequencer": "^30.5.2",
    "@modelcontextprotocol/client": "^2.3.1",
    "cross-env": "^10.1.0",
    "cross-spawn": "^7.0.6",
    "date-fns": "^4.4.0",
    "esbuild": "0.28.2",
    "glob": "^13.0.6",
    "jest": "^30.5.2",
    "jszip": "^3.10.2",
    "shell-quote": "^1.12.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "3.1154.0",
    "@aws-sdk/client-s3": "3.1154.0",
    "@aws-sdk/client-ssm": "3.1154.0",
    "@aws-sdk/client-sts": "3.1154.0",
    "@aws-sdk/client-sso-oidc": "3.1154.0",
    "@aws-sdk/core": "^3.978.5",
    "@aws-sdk/credential-providers": "3.1154.0",
    "@axiomhq/js": "1.3.1",
    "@dagrejs/graphlib": "^2.2.4",
    "@dopplerhq/node-sdk": "^1.3.0",
    "@octokit/rest": "^21.1.1",
    "@serverless-inc/sdk": "^2.11.1",
    "@serverless/engine": "*",
    "@serverless/framework": "*",
    "@serverless/mcp": "*",
    "@serverless/util": "*",
    "@smithy/core": "^3.36.0",
    "@smithy/node-http-handler": "^4.12.1",
    "adm-zip": "^0.6.0",
    "child-process-ext": "^3.0.2",
    "dotenv": "^18.0.9",
    "fs-extra": "^11.4.1",
    "graceful-fs": "^4.2.11",
    "js-yaml": "^4.3.2",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "open": "^10.2.0",
    "simple-git": "^4.0.2",
    "table": "^6.9.0",
    "traverse": "^0.6.14",
    "tsx": "^4.23.15",
    "type": "^2.7.3",
    "ws": "^8.22.0",
    "yaml-ast-parser": "^0.0.43",
    "yargs": "^17.7.3",
    "zod": "^4.6.7"
  },
  "bin": {
    "sf-core": "bin/sf-core.js"
  },
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "description": ""
}
